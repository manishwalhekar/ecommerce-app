<%- include('../partials/header') %>

<div class="admin-page">

  <div class="admin-header">

    <div>
      <p class="admin-header__eyebrow">
        Administration
      </p>

      <h1>
        <%= user ? 'Edit User' : 'Create User' %>
      </h1>
    </div>

    <a
      href="/admin/users"
      class="admin-button admin-button--secondary"
    >
      Back to Users
    </a>

  </div>

  <%- include('_nav') %>

  <div class="admin-form-card">

    <% if (error) { %>

      <div class="admin-form-error">
        <%= error %>
      </div>

    <% } %>

    <form
      action="<%= user ? '/admin/users/' + user.id : '/admin/users' %>"
      method="POST"
    >

      <div class="admin-form-grid">

        <div class="admin-form-group">

          <label for="name">
            Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            value="<%= user?.name || '' %>"
            maxlength="100"
            required
          >

        </div>


        <div class="admin-form-group">

          <label for="email">
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            value="<%= user?.email || '' %>"
            maxlength="255"
            required
          >

        </div>


        <div class="admin-form-group">

          <label for="role">
            Role
          </label>

          <select
            id="role"
            name="role"
            required
          >

            <option
              value="customer"
              <%= user?.role === 'customer' || !user ? 'selected' : '' %>
            >
              Customer
            </option>

            <option
              value="admin"
              <%= user?.role === 'admin' ? 'selected' : '' %>
            >
              Admin
            </option>

          </select>

        </div>


        <div class="admin-form-group">

          <label for="password">

            Password

            <% if (user) { %>
              <span class="admin-form-help">
                Leave blank to keep the current password.
              </span>
            <% } %>

          </label>

          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            <%= user ? '' : 'required' %>
          >

          <p class="admin-form-help">
            Minimum 8 characters.
          </p>

        </div>

      </div>


      <div class="admin-form-actions">

        <button
          type="submit"
          class="admin-button"
        >
          <%= user ? 'Save Changes' : 'Create User' %>
        </button>

        <a
          href="/admin/users"
          class="admin-button admin-button--secondary"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

</div>

<%- include('../partials/footer') %>