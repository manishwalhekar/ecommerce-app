<%- include('partials/header') %>

<div class="product-detail">
  <img src="/products/<%= product.id %>/image" alt="<%= product.name %>" class="product-detail__image">
  <div class="product-detail__body">
    <a href="/" class="back-link">&larr; Back to shop</a>
    <h1><%= product.name %></h1>
    <p class="price price--large">$<%= (product.price_cents / 100).toFixed(2) %></p>
    <p class="description"><%= product.description %></p>

    <% if (product.stock <= 0) { %>
      <p class="stock-flag">Out of stock</p>
    <% } else { %>
      <p class="stock-note"><%= product.stock %> in stock</p>
      <form action="/cart/add/<%= product.id %>" method="POST" class="add-form">
        <label for="quantity">Quantity</label>
        <input type="number" id="quantity" name="quantity" min="1" max="<%= product.stock %>" value="1">
        <button type="submit" class="btn">Add to cart</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
